; Engine configuration file.
config_version=5

[application]

config/name="Snowbound"
config/description="Historical figures trapped on a snowbound sleeper train. Someone is killing them. You are Confucius, and you are a suspect too."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.03, 0.03, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
limits/opengl/max_lights_per_object=12
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
